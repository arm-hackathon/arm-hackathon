    "evaluation_split_requirement": "cover every declared operating and fault-condition stratum before evaluation"
  },
  "observations": {
    "candidate_metric_scope": "all_candidate_actions",
    "executed_metric_scope": "selected_and_executed_decisions",
    "command_identity_fields": [
      "requested_command_sha256",
      "final_command_sha256",
      "executed_command_sha256"
    ],
    "disposition_types": [
      "PROPOSED_ACCEPTED",
      "PROPOSED_MODIFIED",
      "PROPOSED_REJECTED_TO_HOLD",
      "EMERGENCY_OVERRIDDEN",
      "ABSTAINED_TO_HOLD"
    ],
    "candidate_and_executed_metrics_must_not_be_conflated": true
  },
  "metrics": {
    "aggregation": "equal_weight_condition_group_means",
    "required_candidate_metrics": [
      "dangerous_event_recall",
      "false_safe_rate",
      "retained_candidate_count"
    ],
    "required_executed_metrics": [
      "proposal_rate",
      "abstention_rate",
      "selected_action_false_safe_rate",
      "hmc_mismatch_rate",
      "disposition_counts"
    ],
    "bootstrap": {
      "resampling_unit": "condition_group",
      "resamples": 10000,
      "seed": 560057,
      "confidence_interval": "equal_tailed_percentile_95"
    },
    "non_vacuity": {
      "minimum_useful_action_count": "must be selected before evaluation",
      "maximum_abstention_rate": "must be selected before evaluation"
    }
  },
  "provenance": {
    "required_identities": [
      "source_identity_sha256",
      "hmc_binding_sha256",
      "hmc_contract_sha256",
      "scenario_sha256",
      "action_catalogue_sha256",
      "alarm_manifest_sha256",
      "feature_manifest_sha256",
      "label_manifest_sha256",
      "risk_model_sha256",
      "point_artifact_sha256"
    ],
    "observation_manifest_scheme": "sorted_canonical_rows_sha256_v1",
    "write_once_output_directory": true,
    "independent_replay_required_for_counterfactual_labels": true
  },
  "data_boundary": {
    "protected_final_suite_allowed": false,
    "future_states_are_labels_only": true,
    "prohibited_runtime_inputs": [
      "hidden_fault_truth",
      "future_measurements",
