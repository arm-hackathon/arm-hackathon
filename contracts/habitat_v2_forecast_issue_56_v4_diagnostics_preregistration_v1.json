    "architecture_selected": false,
    "training_started": false,
    "artifact_export_started": false,
    "runtime_integration_started": false,
    "next_decision": "authorize or reject a separate V4 learned-model protocol after diagnostic review"
  },
  "non_goals": [
    "no V3 artifact, threshold, feature contract, or historical evidence changes",
    "no HMC, physics, safety-core, capability, trace, or replay authority changes",
