    "lookahead": "for_each_catalogue_action_advance_the_true_plant_8_steps_repeating_the_action_command_each_step",
    "score": "safety_exposure_lookahead + comfort_lookahead + 0.1 * resource_composite_lookahead_on_true_states",
    "infeasible_rule": "candidate_that_cannot_complete_8_feasible_steps_is_excluded",
