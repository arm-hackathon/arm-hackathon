  },
  "target_layout": {
    "kind": "track_a_float32_8x51",
    "columns": "8 zones x (temperature_k, pressure_pa, co2_ppm, o2_mole_fraction, relative_humidity, branch_airflow_m3_s) + (battery_soc, oxygen_store, sorbent_remaining)",
    "bounds_source": "frozen_issue52_scoring_bounds_identical_to_issue54_evaluation_arrays",
    "zone_fields": [
      { "field": "temperature_k", "nominal": 295.15, "scale": 10.0, "lower": 250.0, "upper": 330.0 },
      { "field": "pressure_pa", "nominal": 101325.0, "scale": 1000.0, "lower": 50000.0, "upper": 150000.0 },
      { "field": "co2_ppm", "nominal": 800.0, "scale": 800.0, "lower": 300.0, "upper": 5000.0 },
      { "field": "o2_mole_fraction", "nominal": 0.2095, "scale": 0.005, "lower": 0.15, "upper": 0.30 },
      { "field": "relative_humidity", "nominal": 0.45, "scale": 0.25, "lower": 0.0, "upper": 1.0 },
