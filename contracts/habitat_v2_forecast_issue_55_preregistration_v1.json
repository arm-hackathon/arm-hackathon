    "resource_fields": [
      { "field": "battery_state_of_charge", "nominal": 0.75, "scale": 0.25, "lower": 0.0, "upper": 1.0 },
      { "field": "oxygen_store_fraction", "nominal": 0.75, "scale": 0.25, "lower": 0.0, "upper": 1.0 },
      { "field": "sorbent_remaining_fraction", "nominal": 0.75, "scale": 0.25, "lower": 0.0, "upper": 1.0 }
    ]
  },
  "metrics": {
    "safety_exposure": "sum_over_steps_and_targets_of_max(0, lower - value)/scale + max(0, value - upper)/scale_on_true_plant_states",
    "safety_violation_steps": "count_of_steps_where_any_true_target_crosses_its_bounds",
    "comfort_deviation": "mean_over_occupied_mode_steps_of_mean_over_temperature_co2_relative_humidity_columns_of_abs(value - nominal)/scale_on_true_plant_states",
    "resource_composite": "sum_of_max(0, initial - final)_of_battery_oxygen_and_sorbent_fraction_columns",
    "hmc_rejection_count": "count_of_decision_steps_where_arbitration_final_command_sha256_differs_from_the_proposed_command_sha256",
    "gap_closure": {
      "formula": "(mean_rules - mean_model) / (mean_rules - mean_oracle)_per_metric_over_equal_weight_family_means",
      "interpretation": "0_percent_equals_rules_alone_100_percent_equals_oracle_ceiling",
      "degenerate_rule": "if_abs_denominator_lt_1e-12_closure_is_undefined_and_reported_as_DEGENERATE_GAP",
      "ci": "bootstrap_10000_resamples_sha256_counter_sampler_seed_550055_resampling_unit_is_family_percentile_2.5_97.5",
      "applies_to": ["safety_exposure", "comfort_deviation", "resource_composite"]
    }
  },
  "advisory_contract": {
    "model_arm_ranking_metric_id": "issue55-advisory-point-ranking-v1",
    "teacher": "action_aware_mlp_v1_sha256_a80628fb298ae2f68fb600ecc70922dfddb39e2560207bbd13463e2d4596ecdd",
    "prediction": "float32_8x51_point_prediction_per_catalogue_action_from_16_step_verified_history",
    "point_mass_bounds": "lower_equals_upper_equals_prediction",
    "score": "tracking + 0.5 * safety + 0.05 * intervention_with_uncertainty_term_zero_by_construction",
    "hard_ineligible": "any_predicted_bound_crossing_of_safety_bounds",
    "tie_break": "(score, safety, intervention, hold_preference, action_id)_identical_ordering_semantics_to_rank_candidates",
    "confidence_field": "null_no_calibrated_confidence_is_claimed",
    "abstain_rule": "if_every_candidate_is_hard_ineligible_no_proposal_is_issued_at_that_decision_and_the_abstention_is_counted_per_episode",
    "source_type": "issue55-model-advisory-v1",
