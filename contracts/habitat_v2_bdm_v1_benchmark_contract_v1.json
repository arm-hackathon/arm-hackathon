  "input_schema": {
    "causal_window": {
      "max_history_steps": 16,
      "timing_rule": "completed_telemetry_at_or_before_decision_step",
      "window_unit": "plant_steps",
      "future_information": "prohibited_except_declared_known_schedules"
    },
    "field_classes": [
      {
        "class_id": "zone_environment_history",
        "description": "Per-zone environmental telemetry over the causal window",
        "fields": [
          {
            "name": "zone_temperature_k",
            "dtype": "float32",
            "shape": "[window_steps, 8]",
            "unit": "K",
            "timing": "causal_window_completed_steps",
            "missingness": "mask_and_staleness_required",
            "observability": "operational_telemetry",
            "provenance": "trace zone records"
          },
          {
            "name": "zone_pressure_pa",
            "dtype": "float32",
            "shape": "[window_steps, 8]",
            "unit": "Pa",
            "timing": "causal_window_completed_steps",
            "missingness": "mask_and_staleness_required",
            "observability": "operational_telemetry",
            "provenance": "trace zone records"
          },
          {
            "name": "zone_co2_ppm",
            "dtype": "float32",
            "shape": "[window_steps, 8]",
            "unit": "ppm",
            "timing": "causal_window_completed_steps",
            "missingness": "mask_and_staleness_required",
            "observability": "operational_telemetry",
            "provenance": "trace zone records"
          },
          {
            "name": "zone_o2_mole_fraction",
            "dtype": "float32",
            "shape": "[window_steps, 8]",
            "unit": "mole_fraction",
            "timing": "causal_window_completed_steps",
            "missingness": "mask_and_staleness_required",
            "observability": "operational_telemetry",
            "provenance": "trace zone records"
          },
          {
            "name": "zone_relative_humidity",
            "dtype": "float32",
            "shape": "[window_steps, 8]",
            "unit": "percent",
            "timing": "causal_window_completed_steps",
            "missingness": "mask_and_staleness_required",
            "observability": "operational_telemetry",
            "provenance": "trace zone records"
          },
          {
            "name": "zone_branch_airflow_m3_s",
            "dtype": "float32",
            "shape": "[window_steps, 8]",
            "unit": "m^3/s",
            "timing": "causal_window_completed_steps",
            "missingness": "mask_and_staleness_required",
            "observability": "operational_telemetry",
            "provenance": "trace zone records"
          }
        ]
      },
      {
        "class_id": "observation_masks_and_staleness",
        "description": "Explicit availability metadata; unmarked zero-imputation is prohibited",
        "fields": [
          {
            "name": "observed_value_mask",
            "dtype": "bool",
            "shape": "[window_steps, 8, 6]",
            "unit": "dimensionless",
            "timing": "causal_window_completed_steps",
            "missingness": "not_applicable",
            "observability": "derived_from_operational_telemetry",
            "provenance": "telemetry availability only; never hidden fault state"
          },
          {
            "name": "steps_since_last_valid_observation",
            "dtype": "int32",
            "shape": "[window_steps, 8, 6]",
            "unit": "plant_steps",
            "timing": "causal_window_completed_steps",
            "missingness": "not_applicable",
            "observability": "derived_from_operational_telemetry",
            "provenance": "telemetry availability only; never hidden fault state"
          }
        ]
      },
      {
        "class_id": "command_and_actuator_feedback",
        "description": "Requested command identity and achieved actuator state over the causal window",
        "fields": [
          {
            "name": "requested_command_vector",
            "dtype": "command_vector",
            "shape": "[window_steps, command_dim]",
            "unit": "mixed_declared_per_component",
            "timing": "causal_window_completed_steps",
            "missingness": "not_applicable",
            "observability": "operational_telemetry",
            "provenance": "trace requested/final command records"
          },
          {
            "name": "achieved_actuator_state",
            "dtype": "command_vector",
            "shape": "[window_steps, command_dim]",
            "unit": "mixed_declared_per_component",
            "timing": "causal_window_completed_steps",
            "missingness": "mask_and_staleness_required",
            "observability": "operational_telemetry",
            "provenance": "trace achieved actuator feedback records"
          }
        ]
      },
      {
        "class_id": "resource_gauges",
        "description": "Declared operational resource gauges only; evaluator-only reserve or audit state is prohibited",
        "fields": [
          {
            "name": "battery_state_of_charge",
            "dtype": "float32",
            "shape": "[window_steps]",
            "unit": "fraction",
            "timing": "causal_window_completed_steps",
            "missingness": "mask_and_staleness_required",
            "observability": "operational_telemetry",
            "provenance": "declared resource gauge records"
          },
          {
            "name": "oxygen_store_fraction",
            "dtype": "float32",
            "shape": "[window_steps]",
            "unit": "fraction",
            "timing": "causal_window_completed_steps",
            "missingness": "mask_and_staleness_required",
            "observability": "operational_telemetry",
            "provenance": "declared resource gauge records"
          },
          {
            "name": "sorbent_fraction",
            "dtype": "float32",
            "shape": "[window_steps]",
            "unit": "fraction",
            "timing": "causal_window_completed_steps",
            "missingness": "mask_and_staleness_required",
            "observability": "operational_telemetry",
            "provenance": "declared resource gauge records"
          }
        ]
      },
      {
        "class_id": "operating_context",
        "description": "Explicit declared operating context; labels are context only and never silently alter physics",
        "fields": [
          {
            "name": "operating_mode_one_hot",
            "dtype": "categorical_one_hot",
            "shape": "[window_steps, 4]",
            "unit": "dimensionless",
            "timing": "causal_window_completed_steps",
            "missingness": "not_applicable",
            "observability": "declared_static_context",
            "provenance": "scenario operating schedule; modes occupied/eva_transition/contingency/dormant"
          }
        ]
      },
      {
        "class_id": "hmc_dispositions_retained",
        "description": "Only dispositions HMC would genuinely retain operationally; future arbitration results are prohibited",
        "fields": [
          {
            "name": "prior_proposal_dispositions",
            "dtype": "categorical_one_hot",
            "shape": "[window_steps, disposition_classes]",
            "unit": "dimensionless",
            "timing": "causal_window_completed_steps",
            "missingness": "not_applicable",
            "observability": "operational_telemetry",
            "provenance": "trace decision records for completed steps only"
          }
        ]
      },
      {
        "class_id": "topology_and_configuration",
        "description": "Known static plant identity available at runtime",
        "fields": [
          {
            "name": "topology_configuration_descriptor",
            "dtype": "descriptor",
            "shape": "[descriptor_dim]",
            "unit": "dimensionless",
            "timing": "static",
            "missingness": "not_applicable",
            "observability": "declared_static_context",
            "provenance": "scenario network topology and configuration identity"
          }
        ]
      },
      {
        "class_id": "candidate_action_encoding",
        "description": "The catalogue action or declared future action plan being scored; supplied per scoring call, never inferred from hidden state",
        "fields": [
          {
            "name": "candidate_action_command_vector",
            "dtype": "command_vector",
            "shape": "[command_dim]",
            "unit": "mixed_declared_per_component",
            "timing": "per_scoring",
            "missingness": "not_applicable",
            "observability": "candidate_encoding",
            "provenance": "frozen action catalogue"
          },
          {
            "name": "candidate_action_index",
            "dtype": "int32",
            "shape": "[1]",
            "unit": "dimensionless",
            "timing": "per_scoring",
            "missingness": "not_applicable",
            "observability": "candidate_encoding",
            "provenance": "frozen action catalogue"
          }
        ]
      },
      {
        "class_id": "declared_known_schedules",
        "description": "Only future schedules explicitly declared known at runtime; empty unless a scenario declares them; undeclared future crew or environmental loads are prohibited",
        "fields": [
          {
            "name": "declared_known_future_schedule",
            "dtype": "float32",
            "shape": "[schedule_dim]",
            "unit": "declared_per_component",
            "timing": "declared_known_future",
            "missingness": "not_applicable",
            "observability": "declared_static_context",
            "provenance": "explicit scenario declaration; prohibited when undeclared"
          }
        ]
      }
    ]
  },
  "prohibited_fields": {
    "items": [
      "hidden_physical_truth",
      "fault_labels_or_future_fault_schedules",
      "simulator_seeds",
      "internal_noise_or_bias_state",
      "future_measurements",
      "counterfactual_outcomes",
      "evaluator_only_reserve_or_audit_state",
      "future_hmc_arbitration_results",
      "undeclared_future_crew_or_environmental_loads"
    ],
    "enforcement": "contract_validator_and_tests; any study feature manifest containing a prohibited item fails closed before fitting"
  },
  "action_catalogue": {
    "actions": [
      "normal-occupied-v1",
      "normal-eva_transition-v1",
      "normal-contingency-v1",
      "normal-dormant-v1"
    ],
    "abstention_allowed": true,
    "catalogue_binding": "forecast_contract_action_catalogue",
    "mutable_in_study": false
  },
  "horizons": {
    "step_keys": [4, 16, 32],
    "episode_remaining_key": 0,
    "semantics": "direct_multi_horizon_prediction_from_decision_step; recursive rollout is not the primary form",
    "source": "V3_HORIZONS plus episode-remaining convention"
  },
  "labels": {
    "trajectory_targets": "fifty_one_target_projection",
    "decision_targets": [
      "crossing_event",
      "safety_exposure",
      "maximum_crossing",
      "comfort_deviation",
      "resource_composite"
    ],
    "action_minus_hold_targets": true,
    "counterfactual_rollouts": "labels_only_never_runtime_inputs",
    "counterfactual_construction": "checkpoint one causal state per decision opportunity; identical prior observations and disturbances; roll out hold and every admissible catalogue action; retain full trajectories and action-minus-hold outcomes"
  },
  "comparison_roster": {
    "arms": [
      {
        "arm_id": "hmc_rules_only",
        "kind": "deterministic_policy",
        "source": "HMC canonical behaviour without advisory proposals",
        "advisory_behind_hmc": false
      },
      {
        "arm_id": "hold_current_command",
        "kind": "deterministic_policy",
        "source": "no proposals; current command continues under HMC safe hold",
        "advisory_behind_hmc": false
      },
      {
        "arm_id": "c8_o2_excess_guard",
        "kind": "deterministic_guard_with_ridge_model",
        "source": "issue_56_v4_model_preregistration_v10 candidate c8",
        "advisory_behind_hmc": true
      },
      {
        "arm_id": "c9_o2_guard_statistical",
        "kind": "hybrid_guard_statistical",
        "source": "issue_56_v4_model_preregistration_v10 candidate c9",
        "advisory_behind_hmc": true
      },
      {
        "arm_id": "action_agnostic_ridge",
        "kind": "learned_linear_baseline",
        "source": "issue_74",
        "advisory_behind_hmc": true
      },
      {
        "arm_id": "action_conditioned_linear",
        "kind": "learned_linear_baseline",
        "source": "issue_74; action-conditioned ridge or controlled linear state-space, choice frozen within issue 74",
        "advisory_behind_hmc": true
      },
      {
        "arm_id": "bdm_v1",
        "kind": "learned_neural_candidate",
        "source": "issue_75",
        "advisory_behind_hmc": true
      }
    ],
    "ablation_arms_from_issue_73": [
      "c8_guard_only",
      "c9_learned_screen_without_guard"
    ]
  },
  "metrics": {
    "polarity": {
      "lower_is_better": [
        "safety_exposure",
        "maximum_crossing",
        "counterfactual_safety_exposure_error",
        "action_value_delta_error",
        "finite_catalogue_regret",
        "harmful_admission_rate",
        "comfort_deviation",
        "resource_composite",
        "resource_depletion",
        "intervention_count",
        "actuator_wear",
        "inference_latency_p99_ms"
      ],
      "higher_is_better": [
        "beneficial_action_precision",
        "beneficial_action_recall",
        "useful_opportunity_recall",
        "action_ranking_quality",
        "interval_coverage_at_declared_level",
        "selected_action_diversity_within_declared_bounds"
      ]
    },
    "decision_metric_hierarchy": [
      "hard_admissibility_violation_counts_must_be_zero",
      "per_family_hard_safety_non_inferiority",
      "paired_aggregate_safety_benefit_or_equal_safety_with_predeclared_resource_benefit",
      "action_value_delta_error_and_finite_catalogue_regret",
      "beneficial_action_precision_and_recall",
      "resource_depletion",
      "comfort_deviation",
      "intervention_cost_and_actuator_wear"
    ],
    "aggregate_forecast_error_status": "secondary_diagnostic_only",
    "independent_statistical_unit": "causal_group",
    "non_independent_units": [
      "paired_sensor_variants",
      "counterfactual_action_branches",
      "decision_steps_within_one_family"
    ],
    "pairing_rule": "identical_exogenous_traces_across_arms",
    "bootstrap": {
      "unit": "causal_group",
      "seed_convention": "preregistered_per_study",
      "resamples_default": 10000
    }
  },
  "split_custody": {
    "partitions": {
      "TRAIN": "fitting_and_scaling_only",
      "DEV": "architecture_and_design_decisions_only",
      "CALIBRATION": "interval_correction_and_abstention_thresholds_only",
      "BLIND_FINAL": "one_preregistered_run_after_candidate_freeze_only"
    },
    "group_disjoint": true,
    "grouping_keys": [
      "causal_scenario_template",
      "physical_parameter_band",
      "fault_mechanism_composition",
      "operating_schedule",
      "action_opportunity",
      "sensor_failure_bundle"
    ],
    "same_group_rule": "paired sensor variants and every counterfactual action branch from one causal starting state remain in one group",
    "sealed_manifest_rule": "BLIND_FINAL manifest hash recorded without outcomes; opening requires the separate one-shot authorization",
    "blind_size_rule": "set by pilot power analysis and materially exceeding three independent evaluation condition groups",
    "calibration_separation": "CALIBRATION is disjoint from model fitting, architecture selection, and blind custody"
  },
  "thresholds": {
    "model_path_latency_p99_ms_maximum": 250.0,
    "decision_thresholds": {
      "safety_non_inferiority_margin": "TBD_FROM_PILOT",
      "action_ranking_quality_minimum": "TBD_FROM_PILOT",
      "finite_catalogue_regret_maximum": "TBD_FROM_PILOT",
      "action_value_delta_error_maximum": "TBD_FROM_PILOT",
      "beneficial_action_recall_minimum": "TBD_FROM_PILOT",
      "harmful_admission_rate_maximum": "TBD_FROM_PILOT",
      "interval_coverage_minimum": "TBD_FROM_PILOT",
      "useful_opportunity_recall_minimum": "TBD_FROM_PILOT",
      "maximum_abstention_on_useful_opportunities": "TBD_FROM_PILOT",
      "minimum_selected_action_diversity": "TBD_FROM_PILOT"
    },
    "pilot_definition": {
      "data": "DEV_partition_only",
      "freeze_rule": "every TBD_FROM_PILOT threshold is frozen in a study preregistration before any closed-loop verdict and before any blind access",
      "no_result_derived_value_may_be_marked_frozen": true
    }
  },
  "stop_criteria": [
    "BDM-v1 cannot beat the action-conditioned linear baseline on action ranking",
    "improvement disappears when the deterministic guard is removed",
    "results depend mostly on one dormant/O2-boundary pattern",
    "uncertainty is badly miscalibrated under family shift",
    "apparent success comes from near-total abstention",
    "one plausible simulator assumption reverses the result",
    "leakage or family overlap is found",
    "any HMC authority or replay inconsistency appears",
    "the blind confirmation fails"
  ],
  "stop_response": "improve the question, corpus, or simulator; never silently add parameters or tune against a failed blind population",
  "claim_boundaries": [
    "all results under this contract are simulator development evidence only",
    "learned components are advisory-only; HMC remains the sole final-command, plant-step, and replay authority",
    "negative and null results are published unchanged",
    "uncertainty estimates are empirical calibration evidence, not formal safety guarantees",
    "no protected blind access occurs in development issues",
    "runtime, packaging, and Arm optimisation work requires Gate 6 conditions and separate authorization"
  ],
  "provenance_bindings": {
    "physics_provenance_contract_id": "habitat_v2_physics_provenance_v1",
    "scenario_schema_versions": [
      "aeolus_habitat_v2_scenario_v4",
      "aeolus_habitat_v2_scenario_v5"
