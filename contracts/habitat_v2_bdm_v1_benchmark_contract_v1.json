{
  "schema_version": "aeolus_habitat_v2_bdm_v1_benchmark_contract_v1",
  "contract_id": "habitat_v2_bdm_v1_benchmark_contract_v1",
  "status": "ACCEPTED_RESEARCH_CONTRACT",
  "authorization": {
    "authorized_by": "repository_owner",
    "authorized_via_issue": 70,
    "authorized_at": "2026-09-05",
    "scope": [
      "freeze_benchmark_and_evidence_contract",
      "no_model_implementation",
      "no_training",
      "no_protected_blind_access"
    ]
  },
  "design_record": "docs/research/2026-09-05-bdm-v1-benchmark-contract.md",
  "primary_hypothesis": "A compact causal belief-dynamics model (BDM-v1) consuming only runtime-observable causal history and an explicit candidate-action encoding can improve HMC-filtered closed-loop decision outcomes over both the frozen deterministic O2-excess guard and an action-conditioned linear baseline on fresh mechanism-held-out development families, with calibrated selective abstention, measured on physical safety outcomes first at the independent causal-group level.",
  "non_claims": [
    "no claim that any AEOLUS simulation is a NASA, Artemis, or Gateway digital twin, a CFD model, flight-qualified, or physically validated",
    "no claim of qualification, certification, deployment readiness, hardware performance, or real-world safety",
    "no claim of learned-model superiority until the Gate 0 attribution, Gate 2 offline, Gate 3 abstention, and Gate 4 closed-loop criteria pass on the frozen contract",
    "no Arm, ONNX, quantisation, packaging, or release claim before Gate 6",
    "no access to or claim about the sealed BLIND_FINAL population before its separate one-shot authorization"
  ],
